# Copy these names into .env locally and your Render environment settings.
# Never commit real secret values.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Django / Render production configuration
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DEBUG=False
DATABASE_URL=
DJANGO_ALLOWED_HOSTS=www.example.com,example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://www.example.com,https://example.com
# Render terminates HTTPS at its edge. Leave this False when using Waitress
# unless trusted proxy forwarding has been explicitly configured and tested.
DJANGO_SECURE_SSL_REDIRECT=False
# Keep at 0 for the first HTTPS deployment; change to 3600 after verification.
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False

# Payments, media, transactional email and support
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Release stock held by abandoned online-payment attempts after this period.
PAYMENT_RESERVATION_MINUTES=30
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Boww & Meow
WHATSAPP_NUMBER=
SUPPORT_EMAIL=
# BREVO_API_KEY takes priority over this value. This fallback is used only
# when no Brevo key is configured (for example, in local development).
EMAIL_BACKEND=
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=Boww & Meow <orders@example.com>
STOREFRONT_BASE_URL=https://your-store.example.com
